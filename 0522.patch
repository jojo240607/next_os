-/* ---------- 系统时钟初始化 ---------- */
-bool rcc_sysclk_init(const rcc_sysclk_config_t *cfg)
-{
-    if (!cfg) return false;
-
-    /* 1. 配置 HSE (如果使用) */
-    if (cfg->sysclk_src == RCC_CLK_HSE || cfg->pll_src == RCC_PLLSRC_HSE) {
-        if (cfg->hse_bypass) {
-            xRCC->CR |= xRCC_CR_HSEBYP;
-        } else {
-            xRCC->CR &= ~xRCC_CR_HSEBYP;
-        }
-        xRCC->CR |= xRCC_CR_HSEON;
