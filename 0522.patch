-        src_freq = plli / cfg->pll_m * cfg->pll_n / cfg->pll_p;
-    }
-    _sysclk = src_freq;
-
-    // 计算 AHB/APB1/APB2
-    // AHB 分频：HCLK = SYSCLK / AHB_DIV (具体值参考手册)
-    uint32_t ahb_div_val;
-    switch (cfg->ahb_div) {
