+
+/* 哈希算法 */
+typedef enum {
+    HASH_ALGO_SHA1   = 0,
+    HASH_ALGO_SHA224 = 1,
+    HASH_ALGO_SHA256 = 2,
+    HASH_ALGO_MD5    = 3
+} hash_algo_t;
+
+/* HASH 配置描述符 */
+typedef struct {
+    hash_algo_t algo;
+    bool        dma_mode;      // 使用 DMA 传输数据
