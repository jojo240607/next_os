 #define GET_TASK_MANAGER(obj) ((Task_manager *)obj)
-//// 触发 PendSV 中断
+
 //  __DSB() 确保所有内存访问完成
-#ifdef SIMULATION
-#define CCMRAM  // 在 Renode 模拟器中，宏定义为空，变量将被分配到普通 RAM
-#else
+#ifdef USE_CCMRAM
