{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "serverpath": "D:/soft/openocd/openocd-4e78563-i686-w64-mingw32/bin/openocd.exe",         // 你的 openocd 路径
            "configFiles": [
                "interface/stlink.cfg",                         // 调试器接口
                "target/stm32f4x.cfg"                           // 目标芯片
            ],
            "svdFile": "STM32F407.svd",                         // 外设寄存器描述文件
            "runToEntryPoint": "main",
        },
        {
            "name": "Run via OpenOCD",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "servertype": "openocd",
            "serverpath": "D:/soft/openocd/openocd-4e78563-i686-w64-mingw32/bin/openocd.exe",
            "searchDir": ["D:/soft/openocd/share/openocd/scripts"],
            "configFiles": ["interface/stlink.cfg", "target/stm32f4x.cfg"],
            //"armToolchainPath": "D:/arm-gnu-toolchain/bin",
            "runToEntryPoint": false,
            "postLaunchCommands": ["continue"]
        }
    ]
}