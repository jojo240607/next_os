:name: STM32F4 Discovery
:description: This script runs Contiki on STM32F4 Discovery.

using sysbus
$name?="STM32F4_Discovery"
mach create $name
machine LoadPlatformDescription @stm32f4_discovery-kit.repl

cpu PerformanceInMips 125
# 添加这一行：启动 GDB 服务器
machine StartGdbServer 3333 true

$bin?=@cmake-build-debug/stm32f4discovery.elf

showAnalyzer sysbus.usart1
showAnalyzer sysbus.uart4
### Set random board UNIQUE ID ###

python "import _random"
python "rand = _random.Random()"

$id1 = `python "print rand.getrandbits(32)"`
$id2 = `python "print rand.getrandbits(32)"`
$id3 = `python "print rand.getrandbits(32)"`
macro reset
"""
    sysbus LoadELF $bin

    sysbus WriteDoubleWord 0x1FFF7A10 $id1
    sysbus WriteDoubleWord 0x1FFF7A14 $id2
    sysbus WriteDoubleWord 0x1FFF7A18 $id3
"""

runMacro $reset
### ─── SPI 调试外设 ──────────────────────────────────
machine LoadPlatformDescription @my_platform.repl

### ─── I2C 调试外设 ──────────────────────────────────
# 模拟 I2C EEPROM / 传感器 (从地址 0x50)
#  写: START→0x50+W→寄存器地址→数据→STOP
#  读: START→0x50+W→寄存器地址→RESTART→0x50+R→读数据→STOP
#machine LoadPlatformDescriptionFromString "i2cDebug: Python.PythonPeripheral @ i2c1 { script: "renode_i2c_slave.py" }"
i2c1 Register adxl345 0x53

###ADC1
adc1 FeedSample 0xFF 0

#sleep 10
#sysbus.gpioPortA OnGPIO 1 true      # 模拟电平变高
#sleep 0.01                     # 让高电平维持一个很短的时间
#sysbus.gpioPortA OnGPIO 1 false   # 模拟电平变低，产生下降沿触发中断

