+    callback_handler cb_handler;
+};
+struct _Os_cb_task {
+    Task base;  // 基类作为第一个成员
+    const Os_cb_taskFun* fun;
+    // TODO: 添加派生类特有的数据成员
+    os_cb_event cb_event;
+    Exti *exti;
+    Queue *callback_list;// exit_callback 队列
+};
+
+// 构造函数声明
+Os_cb_task* os_cb_task_create();
