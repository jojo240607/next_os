+    }
+    uart_xfer_t *x = &self->uart_xfer;
+    if (x->rx_active) {
+        return;
+    }
+
+    x->rx_buf = buffer;
+    x->rx_total = len;
+    x->rx_index = 0;
+    x->rx_active = true;
+
+    xUSART_TypeDef *uart = USARTx[self->conf->id];
+    uart->CR1 |= (1 << 5);   // RXNEIE
+    self->uart_rx_sem->fun->take(self->uart_rx_sem);
+}
 
