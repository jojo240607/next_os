+    PI10_REQ_EVENT_OUT      = AF_REQ_ENCODE(PORT_I, PIN_10, AF_EVENTOUT),
+
+    PI11_REQ_OTG_HS_ULPI_DIR  = AF_REQ_ENCODE(PORT_I, PIN_11, AF_OTG_HS),
+    PI11_REQ_EVENT_OUT      = AF_REQ_ENCODE(PORT_I, PIN_11, AF_EVENTOUT),
+
+} pin_af;
+
+/* 上下拉 */
+typedef enum : uint8_t {
+    PIN_PUPD_NONE = 0,
+    PIN_PUPD_PULLUP,
+    PIN_PUPD_PULLDOWN,
+} pin_pupd;
+
+/* 新增：中断触发类型 */
+typedef enum : uint8_t {
+    PIN_IRQ_MODE_NONE = 0,  // 无中断
+    PIN_IRQ_MODE_RISING,    // 上升沿
+    PIN_IRQ_MODE_FALLING,   // 下降沿
+    PIN_IRQ_MODE_BOTH       // 双边沿
+} exti_mode;
+
+
+/* ---------- 寄存器定义（仅需用到的部分） ---------- */
+typedef struct {
+    volatile uint32_t MODER;
+    volatile uint32_t OTYPER;
+    volatile uint32_t OSPEEDR;
+    volatile uint32_t PUPDR;
+    volatile uint32_t IDR;
+    volatile uint32_t ODR;
+    volatile uint32_t BSRR;
+    volatile uint32_t LCKR;
+    volatile uint32_t AFRL;    /* 偏移 0x20, 引脚 0..7 */
+    volatile uint32_t AFRH;    /* 偏移 0x24, 引脚 8..15 */
+} xGPIO_TypeDef;
+
+/* SYSCFG 基地址 */
+#define xSYSCFG_BASE 0x40013800UL
+typedef struct {
+    volatile uint32_t MEMRMP;
+    volatile uint32_t PMC;
+    volatile uint32_t EXTICR[4];   // 四个寄存器，每个管理4个EXTI线
+    // ... 其他寄存器忽略
+} xSYSCFG_TypeDef;
+#define xSYSCFG ((xSYSCFG_TypeDef*)xSYSCFG_BASE)
+
+extern xGPIO_TypeDef* const GPIOx[];
+
+
+void hal_gpio_clock_enable(gpio_port_t port);
+void hal_gpio_set_mode(xGPIO_TypeDef *gpiox, uint8_t pin, pin_mode mode);
+void hal_gpio_set_af(xGPIO_TypeDef *gpiox, uint8_t pin, uint8_t af);
+void hal_gpio_set_otype(xGPIO_TypeDef *gpiox, uint8_t pin, pin_otype otype);
+void hal_gpio_set_ospeed(xGPIO_TypeDef *gpiox, uint8_t pin, pin_ospeed ospeed);
+void hal_gpio_set_pupd(xGPIO_TypeDef *gpiox, uint8_t pin, pin_pupd pupd);
+#endif //STM32F4DISCOVERY_HAL_GPIO_H
