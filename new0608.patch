+
+/* LCD over FSMC 配置 (纯 LCD, 无 FSMC 总线字段) */
+typedef struct {
+    dev_id_t bus_dev_id;             /* FSMC 总线设备 ID */
+    uint16_t width;
+    uint16_t height;
+    uint8_t  rs_addr_line;
+    gpio_t   rst_pin;
+    gpio_t   bl_pin;
