-        {.mode = PIN_MODE_AF, .otype = PIN_OTYPE_OD, .ospeed = PIN_OSPEED_HIGH,
-         .pupd = PIN_PUPD_NONE, .af = p->scl_pin },
-        {.mode = PIN_MODE_AF, .otype = PIN_OTYPE_OD, .ospeed = PIN_OSPEED_HIGH,
-         .pupd = PIN_PUPD_NONE, .af = p->sda_pin },
-    };
-    for (int i = 0; i < 2; i++) {
-        if (pinmux_request(&pins[i]) != PINMUX_SUCCESS) {
-            LOG_ERROR("i2c", "pinmux error");
