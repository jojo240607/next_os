+    uint32_t v = xI2S_I2SCFGR_I2SMOD;
+    v |= (mode & 0x3) << 8;
+    v |= (std & 0x3) << 4;
+    if (pcm_sync) v |= xI2S_I2SCFGR_PCMSYNC;
+    if (clock_polarity) v |= (1 << 3);
+    v |= (data_format & 0x3) << 1;
