+void hal_i2s_config_pll(i2s_id_t id, uint32_t plln, uint32_t pllr) {
+    (void)id;
+    volatile uint32_t *PLLI2SCFGR = (uint32_t*)0x40023884UL;
+    *PLLI2SCFGR = (pllr & 0x7) << 28 | (plln & 0x1FF) << 6;
+    volatile uint32_t *CR = (uint32_t*)0x40023800UL;
+    *CR |= (1 << 26);
